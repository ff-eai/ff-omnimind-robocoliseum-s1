-# Copyright (c) 2026 FF EAI Robotics Ecosystem Inc. All rights reserved. See LICENSE-FF.txt.
-# AgiBot G2 as the RoboColiseum leaderboard serves it: upstream genie_sim main
-# (not our local-depth patch) driving the same GenieSim 3.2 G2_omnipicker.
-#
-# Identical to the local geniesim-default copy every v3.x program was tuned and
-# evaluated with (a local copy of geniesim-default: gripper
-# full_travel_s 0.4, final_joint_tolerance_rad 0.20) except the wire, which the
-# 2026-10-25 probe of the live server measured:
-#   * depth: RAW_UINT16 millimetres for all three cameras (depth_scale 1000),
-#     on an episode's first request and afterwards only while need_depth asks;
-#   * no camera_poses: camera poses come from FK (camera_pose_source: fk);
-#   * head_joint_states empty: FK uses head.hold = GenieSim G2_DEFAULT_STATES
-#     head_state [0, 0, 0.11464] (every instruction task); checked 2026-10-26:
-#     the probe's head depth then puts the table at 0.7317 m, tilt 0.2 deg --
-#     the local value -- while zeros would put it 40 mm high and 6.3 deg tilted;
-#   * 120 s inference timeout: keepalive holds on, reply_timeout_s 60 s to leave
-#     room for a ~6.7 MB depth request crossing the Pacific (12-18 s).
-#
-# Provenance tags as in geniesim-default:
-#   [USD]  read from the simulated asset with usd-core on 2026-10-21;
-#   [ROBOT] read read-only from the real G2; [ASSUMED] not measured.
-#   [PROBE] measured on the leaderboard server, job 1635, 2026-10-25.
-schema_version: 1
-station: geniesim-leaderboard
-backend: geniesim
-base_frame: base_link
-default_arm: right
-arm_aliases:
-  primary: right
-  secondary: left
-
-arms:
-  left:
-    # cuRobo / URDF names (G2_omnipicker_fixed_dual.yml cspace order).
-    joint_names:
-      - idx21_arm_l_joint1
-      - idx22_arm_l_joint2
-      - idx23_arm_l_joint3
-      - idx24_arm_l_joint4
-      - idx25_arm_l_joint5
-      - idx26_arm_l_joint6
-      - idx27_arm_l_joint7
-    # [ROBOT] initial_pose.json left_arm_standard; GenieSim tasks start from
-    # their own per-task init_arm, which reset() does not override.
-    home_joints: [1.5707963267948966, -1.5707963267948966, -1.5707963267948966, -1.5707963267948966, 0.0, 0.0, 0.0]
-    ready_joints: [1.5707963267948966, -1.5707963267948966, -1.5707963267948966, -1.5707963267948966, 0.0, 0.0, 0.0]
-    # [ROBOT] identified URDF j1..j7 limits; the sim URDF carries the same values.
-    limits:
-      lower: [-3.072, -2.060, -3.072, -2.496, -3.072, -1.012, -1.536]
-      upper: [3.072, 2.060, 3.072, 1.012, 3.072, 1.012, 1.536]
-    tool_frame: gripper_l_center_link
-    end_link: arm_l_end_link
-    # [USD] end_link -> gripper_l_center_link along end_link z: 0.00537 (ee joint)
-    # + 0.14308 (centre joint). The real omnipicker is 0.14308 straight from
-    # end_link (gdk-real profile). end_link itself is 0.088 m from link7 in the
-    # sim (0.09 on the real robot).
-    tool_offset_m: 0.14845
-  right:
-    joint_names:
-      - idx61_arm_r_joint1
-      - idx62_arm_r_joint2
-      - idx63_arm_r_joint3
-      - idx64_arm_r_joint4
-      - idx65_arm_r_joint5
-      - idx66_arm_r_joint6
-      - idx67_arm_r_joint7
-    # [ROBOT] initial_pose.json right_arm_standard.
-    home_joints: [-1.5707963267948966, -1.5707963267948966, 1.5707963267948966, -1.5707963267948966, 0.0, 0.0, 0.0]
-    ready_joints: [-1.5707963267948966, -1.5707963267948966, 1.5707963267948966, -1.5707963267948966, 0.0, 0.0, 0.0]
-    limits:
-      lower: [-3.072, -2.060, -3.072, -2.496, -3.072, -1.012, -1.536]
-      upper: [3.072, 2.060, 3.072, 1.012, 3.072, 1.012, 1.536]
-    tool_frame: gripper_r_center_link
-    end_link: arm_r_end_link
-    tool_offset_m: 0.14845
-
-waist:
