-    frame_convention: opengl
-    # [USD] head_front_Camera omni:lensdistortion:opencvPinhole k1, k2, p1, p2, k3 (k4-k6 0): the image is
-    # rendered through this lens; the planning scene back-projects along the undistorted rays.
-    distortion: [-0.031128239, 0.032714073, 0.0002466687, 0.0000032654, -0.011283846]
