-  hold: [-0.6981317007977318, 1.5707963267948966, -0.8726646259971648, 0.0, 0.0]
-  limits:
-    lower: [-1.082, 0.0, -1.907, -0.436, -3.046]
-    upper: [0.0, 2.653, 1.039, 0.436, 3.046]
-
-head:
-  joint_names: [idx11_head_joint1, idx12_head_joint2, idx13_head_joint3]
-  # [PROBE] the request's head_joint_states is empty; GenieSim holds the head at
-  # the task's init head_state, G2_DEFAULT_STATES [0, 0, 0.11464] on the whole
-  # instruction board (robot_init_states.py). FK uses this whenever the head
-  # vector is empty. Other boards use other init states (e.g. G2_STATES_5
-  # [0, 0, 0.1745]): check before serving them.
-  hold: [0.0, 0.0, 0.11464]
-  # Manipulation board (C5m, g2-v43): the tasks whose init head_state differs from the hold, per client task name
-  # (GenieSim robot_init_states.py: take_wrong_item_shelf G2_STATES_5 [0, 0, 0.1745]; scoop_popcorn G2_STATES_6
-  # [0, 0, 0]). Every other manipulation task starts with [0, 0, 0.11464] (G2_DEFAULT_STATES / _STATES_1 / _STATES_4).
-  task_holds:
-    take_wrong_item_shelf: [0.0, 0.0, 0.1745]
-    scoop_popcorn: [0.0, 0.0, 0.0]
-  limits:
-    lower: [-1.571, -0.349, -0.524]
-    upper: [1.571, 0.349, 0.524]
-
-gripper:
-  # Normalized contract: 0 closed, 1 open.
-  closed: 0.0
-  open: 1.0
-  # Omnipicker joint range [-0.785, 0]; -0.785 is fully open.
-  raw_open: -0.785
-  raw_closed: 0.0
-  # The wire carries the dataset / real-robot convention directly: -0.785 is
-  # fully open, 0 is closed, for both gripper_states and the effector reply.
-  # GenieSim's gripper_scale = -1 (label_state_crsb / process_gripper_action_crsb)
-  # only converts between that and its internal sim joint (+0.785 open); it is
-  # invisible to the policy. Measured 2026-10-21: commanding -0.785 reads
-  # back -0.785 (open), commanding 0.0 reads back 0.0 (closed).
-  wire_scale: 1.0
-  # Ticks a set_gripper command is held for before the next observation is read
-  # (full_travel_s x control_frequency_hz).
-  full_travel_s: 0.4  # local copy: 12 rows per gripper command instead of 30; the episode budget is ~180 rows
-  stall_delta: 0.01
-  stall_steps: 5
-
-# [ASSUMED] base_link-frame box bounding both arms' reach. Refine once the
