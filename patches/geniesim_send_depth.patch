GenieSim 3.2 local-evaluation patch: send depth and camera poses to the policy server
=====================================================================================

Target:  GenieSim (https://github.com/AgibotTech/genie_sim) tag v3.2.0, commit 0e659ad.
Scope:   four files under source/geniesim_benchmark/src/geniesim_benchmark/.
Effect:  a new benchmark config flag `benchmark.send_depth` (default false, so the
         leaderboard payload is byte-for-byte unchanged). When true, the serial
         CoRobotPolicy payload also carries
           params.images.head_depth / hand_left_depth / hand_right_depth
             RAW_UINT16, metres x1000 (head) and x10000 (hands), the encoding the
             stock client already had commented out (_encode_depth), and
           params.camera_poses = {"frame": "world", "base_link": 4x4,
             "head": 4x4, "hand_left": 4x4, "hand_right": 4x4}
             world poses of the camera prims in the OpenCV optical convention
             (api_core.get_obj_world_pose_matrix(camera=True) applies the Isaac
             Rx(180)) plus base_link, so the server can re-express them.
         The vectorized path (enable_vec) builds its obs without depth and is not
         covered. ASPIRE's codec decodes both fields (cap_harness/g2/codec.py).

Enable:  python ... --benchmark.send_depth true    (or send_depth: true under
         benchmark: in config.yaml)

Apply:   cd <genie_sim checkout at v3.2.0>
         git apply --check <this repository>/patches/geniesim_send_depth.patch
         git apply         <this repository>/patches/geniesim_send_depth.patch
Revert:  git apply -R      <this repository>/patches/geniesim_send_depth.patch

Leading text before the first `diff --git` is ignored by git apply.

diff --git a/source/geniesim_benchmark/src/geniesim_benchmark/benchmark/envs/pi_env.py b/source/geniesim_benchmark/src/geniesim_benchmark/benchmark/envs/pi_env.py
index c254221..e6cc8eb 100755
--- a/source/geniesim_benchmark/src/geniesim_benchmark/benchmark/envs/pi_env.py
+++ b/source/geniesim_benchmark/src/geniesim_benchmark/benchmark/envs/pi_env.py
@@ -55,9 +55,37 @@ class PiEnv(DummyEnv):
         self.cur_arm = states["left_arm"] + states["right_arm"]
 
         obs = {"images": images, "states": states, "depth": None}
+        if getattr(self, "send_depth", False) and fetch_images:
+            # Local eval only (benchmark.send_depth): the bundle already fetched
+            # depth alongside the images; pass it through with the camera poses.
+            obs["depth"] = bundle.get("depth")
+            obs["camera_poses"] = self._camera_world_poses()
         obs["eef"] = self.ikfk_solver.compute_eef(self.cur_arm)
         return obs
 
+    def _camera_world_poses(self):
+        """World poses (4x4 lists) of the payload cameras in the OpenCV optical
+        convention (api_core applies the Isaac camera Rx(180)), plus base_link so
+        the server can re-express them in the robot frame."""
+        poses = {"frame": "world"}
+        api = self.api_core
+        try:
+            poses["base_link"] = api.get_obj_world_pose_matrix(f"{api.robot_prim_path}/base_link").tolist()
+        except Exception as e:
+            logger.warning(f"base_link pose unavailable: {e}")
+        payload_names = {"head": "head", "left_hand": "hand_left", "right_hand": "hand_right"}
+        cam_dirs = self.data_courier._camera_dirs()
+        for prim in getattr(api.robot_cfg, "cam_prim_path", []):
+            cam_id = prim.split("/")[-1].lower()
+            for obs_name, payload_name in payload_names.items():
+                if cam_dirs.get(obs_name) != cam_id:
+                    continue
+                try:
+                    poses[payload_name] = api.get_obj_world_pose_matrix(prim, camera=True).tolist()
+                except Exception as e:
+                    logger.warning(f"camera pose unavailable for {prim}: {e}")
+        return poses
+
     def reset(self):
         self._followed_objects = set()
         self._picked_objects = set()
