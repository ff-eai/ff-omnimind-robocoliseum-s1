@@ -144,6 +147,24 @@ class CoRobotPolicy(BasePolicy):
             "width": image_rgb.shape[1],
         }
 
+    # Payload depth key and uint16 scale per obs camera (see _encode_depth).
+    _DEPTH_FIELDS = (
+        ("head", "head_depth", 1000),
+        ("left_hand", "hand_left_depth", 10000),
+        ("right_hand", "hand_right_depth", 10000),
+    )
+
+    def _attach_depth(self, params, obs):
+        """Local eval only: depth maps the env fetched with the images, and the
+        camera / base_link world poses when the env provided them."""
+        depth = obs.get("depth") or {}
+        for cam, key, scale in self._DEPTH_FIELDS:
+            if depth.get(cam) is not None:
+                params["images"][key] = self._encode_depth(np.asarray(depth[cam], dtype=np.float32), scale)
+        camera_poses = obs.get("camera_poses")
+        if camera_poses:
+            params["camera_poses"] = camera_poses
+
     @staticmethod
     def _encode_depth(depth_map: np.ndarray, scale: int) -> dict:
         depth = np.nan_to_num(depth_map, nan=0.0, posinf=0.0, neginf=0.0)
